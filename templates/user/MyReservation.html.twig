{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}

    <head>

        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
        <meta name="description" content="">
        <meta name="author" content="Tooplate">
        <link href="https://fonts.googleapis.com/css?family=Poppins:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&display=swap" rel="stylesheet">

        <title>My Reservations</title>


        <!-- Additional CSS Files -->
        <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/bootstrap.min.css') }}">

        <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/font-awesome.css') }}">

        <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/owl-carousel.css') }}">

        <link rel="stylesheet" href="{{ asset('assets/css/tooplate-artxibition.css') }}">
    </head>

    <body>

    <!-- ***** Preloader Start ***** -->
    <div id="js-preloader" class="js-preloader">
        <div class="preloader-inner">
            <span class="dot"></span>
            <div class="dots">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </div>
    <!-- ***** Preloader End ***** -->

    <!-- ***** Pre HEader ***** -->
    <div class="pre-header">
        <div class="container">

        </div>
    </div>

    <!-- ***** Header Area Start ***** -->
    <header class="header-area header-sticky">
        <div class="container">
            <div class="row">
                <div class="col-12">

                </div>
            </div>
        </div>
    </header>
    <!-- ***** Header Area End ***** -->

    <!-- ***** About Us Page ***** -->
    <div class="page-heading-rent-venue">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <h2>My Reservations </h2>
                    <span>Your ideal shows & events destination .</span>
                </div>
            </div>
        </div>
    </div>

    <div class="shows-events-tabs">
        <div class="container">

            <div class="row">

                <div class="col-lg-12">
                    <div class="section-heading">
                    </div>
                </div>
                <div class="col-lg-12 mb-4">
                    <ul>
                        {% for reservation in reservations %}
                            <li class="list-group-item border-bottom">
                                <div class="row">
                                    <!-- Nom de l'événement -->
                                    <div class="col-lg-2">
                                        <div class="title">
                                            <span><i class="fa fa-calendar"></i> {{ reservation.event.getNom() }}</span>
                                        </div>
                                    </div>
                                    <!-- Catégories -->
                                    <div class="col-lg-2">
                                        <div class="time">
                    <span>
                        <i class="fa fa-tags"></i>
                        {% for category in reservation.event.getCategory() %}
                            {{ category }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </span>
                                        </div>
                                    </div>
                                    <!-- Adresse -->
                                    <div class="col-lg-2">
                                        <div class="place">
                                            <span><i class="fa fa-map-marker"></i> {{ reservation.event.local.getAdr() }}</span>
                                        </div>
                                    </div>
                                    <!-- Prix -->
                                    <div class="col-lg-2">
                                        <div class="price">
                                            <span><i class="fa fa-money"></i> {{ reservation.event.getPrix() }} TND</span>
                                        </div>
                                    </div>
                                    <!-- Date -->
                                    <div class="col-lg-2">
                                        <div class="date">
                                            <span><i class="fa fa-clock-o"></i> {{ reservation.event.getDate|date('d/m/Y') }}</span>
                                        </div>
                                    </div>
                                    <!-- Organisateur -->
                                    <div class="col-lg-2">
                                        <div class="organizer">

                                            <span><i class="fa fa-user"></i> Organized By {{ reservation.event.getOrganizer().getName() }}</span>
                                        </div>
                                    </div>
                                    <!-- Actions -->
                                    <div class="col-lg-12 mt-2">
                                        <div class="row">
                                            <div class="col-auto">
                                               <button style="background-color: #062c33;color: white" class="btn"> <a href="{{ path('event_details',{'id':reservation.event.id}) }}" style="color: white"> Event Details</a></button>

                                            </div>
                                            <div class="col-auto">
                                                {{ include('reservation/delete_reservation.html.twig') }}
                                            </div>
                                            {% if reservation.status != 'Confirmed' %}
                                                <div class="col-auto">
                                                    {{ include('reservation/confirm_reservation.html.twig') }}
                                                </div>
                                            {% else %}
                                                <div class="col-auto">
                                                    <button disabled="disabled" class="btn" style="background-color: #062c33; color: white">Payed</button>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </li>
                        {% else %}
                            <li>
                                <div class="no-records">
                                    <p>No Reservations found</p>
                                </div>
                            </li>
                        {% endfor %}

                    </ul>

                </div>
            </div>
        </div>

    </div>


    <!-- *** Subscribe *** -->
    <div class="subscribe">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <h4>Subscribe Our Newsletter:</h4>
                </div>
                <div class="col-lg-8">
                    <form id="subscribe" action="" method="get">
                        <div class="row">
                            <div class="col-lg-9">
                                <fieldset>
                                    <input name="email" type="text" id="email" pattern="[^ @]*@[^ @]*" placeholder="Your Email Address" required="">
                                </fieldset>
                            </div>
                            <div class="col-lg-3">
                                <fieldset>
                                    <button type="submit" id="form-submit" class="main-dark-button">Submit</button>
                                </fieldset>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- *** Footer *** -->



    <!-- jQuery -->
    <script src="{{ asset('assets/js/jquery-2.1.0.min.js') }}"></script>

    <!-- Bootstrap -->
    <script src="{{ asset('assets/js/popper.js') }}"></script>
    <script src="{{ asset('assets/js/bootstrap.min.js') }}"></script>

    <!-- Plugins -->
    <script src="{{ asset('assets/js/scrollreveal.min.js') }}"></script>
    <script src="{{ asset('assets/js/waypoints.min.js') }}"></script>
    <script src="{{ asset('assets/js/jquery.counterup.min.js') }}"></script>
    <script src="{{ asset('assets/js/imgfix.min.js') }}"></script>
    <script src="{{ asset('assets/js/mixitup.js') }}"></script>
    <script src="{{ asset('assets/js/accordions.js') }}"></script>
    <script src="{{ asset('assets/js/owl-carousel.js') }}"></script>

    <!-- Global Init -->
    <script src="{{ asset('assets/js/custom.js') }}"></script>

    </body>

{% endblock %}