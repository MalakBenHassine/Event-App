<body>
<header class="header-area header-sticky">
    <div class="container" >
        <div  >
            <div class="col-30" >
                <nav class="main-nav">
                    <!-- ***** Logo Start ***** -->
                    <a href="{{ path('app_home') }}" class="logo">My<em>Event</em></a>
                    <!-- ***** Logo End ***** -->

                    <!-- ***** Menu Start ***** -->
                    <ul class="nav">
                        <li><a href="{{ path('app_event') }}">UpComing Events</a></li>



                        {% if is_granted('ROLE_LOCATOR') %}
                            <li><a href="{{ asset('rent-venue.html') }}">My Locals</a></li>
                            <li><a href="{{ path('app_local_new') }}">Create Local</a></li>

                        {% endif %}

                        {% if is_granted('ROLE_PARTICIPANT') %}
                            <li><a href="{{ asset('myEventUser.html') }}">My Events</a></li>
                        {% endif %}

                        {% if is_granted('ROLE_ORGANIZER') %}
                            <li><a href="{{ asset('myEventOrg.html') }}">My Events</a></li>
                            <li><a href="{{ path('app_new') }}">Create event</a></li>
                            <li><a href="{{ asset('rent-venue.html') }}">Locals</a></li>

                        {% endif %}


                        <li><a href="{{ asset('contact.html') }}">Contact Us</a></li>


                        <!-- Login aligned to the right -->
                        {% if app.user %}
                            <div><h3 style="color: #0c5460">{{ app.user.name }}</h3><a href="{{path('app_logout') }}"><h5 style="color: #1b1e21"><i style="color: #1d2124" class="fa fa-fw fa-user"></i>Logout</h5></a>
                            </div>
                        {% else %}
                            <li class="right-align"><a href="{{ path('app_login') }}"><i class="fa fa-fw fa-user"></i>Login</a></li>

                        {% endif %}
                    </ul>

                    <!-- Menu Trigger (for mobile view) -->

                    <!-- ***** Menu End ***** -->
                </nav>

            </div>
        </div>
    </div>
</header>
{% if app.user %}

{% endif %}
