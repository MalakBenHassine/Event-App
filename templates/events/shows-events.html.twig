{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="Tooplate">
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&display=swap" rel="stylesheet">

    <title>ArtXibition Template - Shows and Events Page</title>


    <!-- Additional CSS Files -->
    <link rel="stylesheet" type="text/css" href="assets/css/bootstrap.min.css">

    <link rel="stylesheet" type="text/css" href="assets/css/font-awesome.css">

    <link rel="stylesheet" type="text/css" href="assets/css/owl-carousel.css">

    <link rel="stylesheet" href="assets/css/tooplate-artxibition.css">
<!--

Tooplate 2125 ArtXibition

https://www.tooplate.com/view/2125-artxibition

-->
    </head>

    <body>




    <div class="page-heading-shows-events">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <h2>Our Shows & Events</h2>
                    <span>Check out upcoming shows & events.</span>
                </div>
            </div>
        </div>
    </div>

    <div class="shows-events-tabs">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="row" id="tabs" style="margin-left: 200px">
                        <div class="col-lg-12">
                            <div class="heading-tabs">
                                <div class="row">
                                    <div class="col-lg-8">
                                        <ul>
                                          <li><a href='#tabs-1'>Upcoming</a></li>
                                        </ul>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <section class='tabs-content'>
                                <article id='tabs-1'>
                                    <div class="row">

                                        <div class="col-lg-9">
                                            <div class="row">
                                                <div class="container mt-4" >

                                                <h4  style="margin-left: 300px">Filter By</h4>
                                                <form method="get" action="{{ path('app_event') }}" class="mb-4">
                                                    <div class="row" >
                                                        <div class="col-lg-3" >

                                                            <input type="text" style="border-radius: 10px;background-color: #062c33;color: white "  name="name" class="form-control" placeholder="Event Name" value="{{ app.request.query.get('name') }}">
                                                        </div>
                                                        <div class="col-lg-3" >
                                                            <input type="date" style="border-radius: 10px;background-color: #062c33;color: white"  name="date_from" class="form-control" placeholder="Date From" value="{{ app.request.query.get('date_from') }}">
                                                        </div>
                                                        <div class="col-lg-3" >
                                                            <select name="category" class="form-control" style="border-radius: 10px;background-color: #062c33;color: white">
                                                                <option value=""> Category </option>
                                                                <option value="party" {% if app.request.query.get('category') == 'party' %}selected{% endif %}>Party</option>
                                                                <option value="conference" {% if app.request.query.get('category') == 'conference' %}selected{% endif %}>Conference</option>
                                                                <option value="workshop" {% if app.request.query.get('category') == 'workshop' %}selected{% endif %}>Workshop</option>
                                                                <option value="training" {% if app.request.query.get('category') == 'training' %}selected{% endif %}>Training</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-lg-3" >
                                                            <select name="local" class="form-control" style="border-radius: 10px; background-color: #062c33;color: white">
                                                                <option value=""> Location </option>
                                                                {% for location in locations %}
                                                                    <option value="{{ location.id }}" {% if app.request.query.get('local') == location.id %}selected{% endif %}>{{ location.name }}</option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="row mt-3" >
                                                        <div class="col-lg-12" style="margin-left: 250px">
                                                            <button type="submit" class="btn btn-primary" style="border-radius: 10px;border-color: #062c33 ; background-color: #0c5460">Apply Filters</button>
                                                            <a style="border-radius: 10px;" href="{{ path('app_event') }}" class="btn btn-secondary">Clear Filters</a>
                                                        </div>
                                                    </div>
                                                </form>
                                                    <div class="container">
                                                        <div class="col" style="margin-left: 230px;margin-bottom: 50px;margin-top: 80px">
                                                            <div class="col-lg-11">
                                                                <div class="main-content">
                                                                    <div class="next-show">
                                                                        <i class="fa fa-arrow-down"></i>
                                                                        <span>Discover Events</span>
                                                                    </div>

                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                            </div>

                                                {% for e in events %}
                                                    <div class="col-lg-12">
                                                        <div class="event-item">
                                                            <div class="row">
                                                                <div class="col-lg-4">
                                                                    <div class="left-content">
                                                                        <h4>{{ e.nom }}</h4>
                                                                        <span><i class="fa fa-money"></i> {{ e.getPrix() }} TND</span>

                                                                        <div class="main-dark-button"><a href="{{ path('event_details',{'id':e.id}) }}">Discover More</a></div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-4">
                                                                    {% if 'party' in e.category %}
                                                                        <div><img class="event-image" src="{{ asset('assets/images/venue-01.jpg') }}" alt=""></div>
                                                                    {% endif %}
                                                                    {% if 'conference' in e.category %}
                                                                        <div><img class="event-image" src="{{ asset('assets/images/download (13).jpg') }}" alt=""></div>
                                                                    {% endif %}
                                                                    {% if 'workshop' in e.category %}
                                                                        <div><img class="event-image" src="{{ asset('assets/images/workshop.jpg') }}" alt=""></div>
                                                                    {% endif %}
                                                                    {% if 'training' in e.category %}
                                                                        <div><img class="event-image" src="{{ asset('assets/images/formation.jpg') }}" alt=""></div>
                                                                    {% endif %}
                                                                </div>
                                                                <div class="col-lg-3">
                                                                    <div class="right-content">
                                                                        <ul>
                                                                            <li>
                                                                                <i class="fa fa-clock-o"></i>
                                                                                <h6>{{ e.date|date('Y-m-d') }}</h6>
                                                                            </li>
                                                                            <li>
                                                                                <i class="fa fa-map-marker"></i>
                                                                                <span>{{ e.local.getAdr()}}</span>
                                                                            </li>
                                                                            <li>
                                                                                <i class="fa fa-users"></i>
                                                                                <span>{{ e.getTotalParticipants()}} Total Guests Attending</span>
                                                                            </li>

                                                                        </ul>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}

                                            </div>
                                        </div>
                                    </div>
                                </article>

                            </section>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- *** Subscribe *** -->
    <div class="subscribe">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <h4>Subscribe Our Newsletter:</h4>
                </div>
                <div class="col-lg-8">
                    <form id="subscribe" action="" method="get">
                        <div class="row">
                          <div class="col-lg-9">
                            <fieldset>
                              <input name="email" type="text" id="email" pattern="[^ @]*@[^ @]*" placeholder="Your Email Address" required="">
                            </fieldset>
                          </div>
                          <div class="col-lg-3">
                            <fieldset>
                              <button type="submit" id="form-submit" class="main-dark-button">Submit</button>
                            </fieldset>
                          </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- *** Footer *** -->




    <!-- jQuery -->
    <script src="assets/js/jquery-2.1.0.min.js"></script>

    <!-- Bootstrap -->
    <script src="assets/js/popper.js"></script>
    <script src="assets/js/bootstrap.min.js"></script>

    <!-- Plugins -->
    <script src="assets/js/scrollreveal.min.js"></script>
    <script src="assets/js/waypoints.min.js"></script>
    <script src="assets/js/jquery.counterup.min.js"></script>
    <script src="assets/js/imgfix.min.js"></script>
    <script src="assets/js/mixitup.js"></script>
    <script src="assets/js/accordions.js"></script>
    <script src="assets/js/owl-carousel.js"></script>

    <!-- Global Init -->
    <script src="assets/js/custom.js"></script>

  </body>

{% endblock %}
