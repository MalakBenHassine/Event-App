
{% extends 'base.html.twig' %}


{% block title %}Home{% endblock %}

{% block body %}

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="Tooplate">
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&display=swap" rel="stylesheet">

    <title>Shows and Events </title>


    <!-- Additional CSS Files -->
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/bootstrap.min.css') }}">

    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/font-awesome.css') }}">

    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/owl-carousel.css') }}">

    <link rel="stylesheet" href="{{ asset('assets/css/tooplate-artxibition.css') }}">
<!--

Tooplate 2125 ArtXibition

https://www.tooplate.com/view/2125-artxibition

-->
    </head>

    <body>

    <!-- ***** Preloader Start ***** -->
    <div id="js-preloader" class="js-preloader">
      <div class="preloader-inner">
        <span class="dot"></span>
        <div class="dots">
          <span></span>
          <span></span>
          <span></span>
        </div>
      </div>
    </div>
    <!-- ***** Preloader End ***** -->

    <!-- ***** Pre HEader ***** -->
    <div class="pre-header">
        <div class="container">

        </div>
    </div>

    <!-- ***** Header Area Start ***** -->
    <header class="header-area header-sticky">
        <div class="container">
            <div class="row">
                <div class="col-12">

                </div>
            </div>
        </div>
    </header>
    <!-- ***** Header Area End ***** -->

    <!-- ***** About Us Page ***** -->
    <div class="page-heading-shows-events">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <h2>Our Shows & Events</h2>
                    <span>Check out upcoming shows & events.</span>
                </div>
            </div>
        </div>
    </div>

    <div class="shows-events-tabs">
        <div class="container">
            <div class="row">
                <div class="col-lg-12">
                    <div class="row" id="tabs">
                        <div class="col-lg-12">
                            <div class="heading-tabs">
                                <div class="row">
                                    <div class="col-lg-8">
                                        <ul>
                                          <li><a href='#tabs-1'>Upcoming</a></li>
                                        </ul>
                                    </div>

                                </div>
                            </div>
                        </div>
                        <div class="col-lg-12">
                            <section class='tabs-content'>
                                <article id='tabs-1'>
                                    <div class="row">

                                        <div class="col-lg-3">
                                            <div class="sidebar">
                                                <div class="row">
                                                    <div class="col-lg-12">
                                                        <div class="heading-sidebar">
                                                            <h4></h4>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-12">
                                                        <div class="month">
                                                            <h6></h6>
                                                            <ul>
                                                                <li></li>
                                                                <li><a ></a></li>
                                                                <li><a ></a></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-12">
                                                        <div class="category">
                                                            <h6></h6>
                                                            <ul>
                                                                <li><a ></a></li>
                                                                <li><a ></a></li>
                                                                <li><a ></a></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                    <div class="col-lg-12">
                                                        <div class="venues">
                                                            <h6></h6>
                                                            <ul>
                                                                <li><a ></a></li>
                                                                <li><a ></a></li>
                                                                <li><a ></a></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-9">
                                            <div class="row">
                                                <div class="container mt-4">

                                                <h5 style="margin: 5px">Sort The Upcoming Shows & Events By:</h5>
                                                <form method="get" action="{{ path('app_event') }}" class="mb-4">
                                                    <div class="row">
                                                        <div class="col-lg-3">

                                                            <input style="background-color:darkslategray; color: white"  type="text" name="name" class="form-control" placeholder="Event Name" value="{{ app.request.query.get('name') }}">
                                                        </div>

                                                        <div class="col-lg-3">
                                                            <input style="background-color:darkslategray;color: white" type="date" name="date_from" class="form-control" placeholder="Date From" value="{{ app.request.query.get('date_from') }}">
                                                        </div>
                                                        <div class="col-lg-3">
                                                            <select name="category" class="form-control" style="background-color:darkslategray;color: white">
                                                                <option value="">-- Select Category --</option>
                                                                <option value="Party" {% if app.request.query.get('category') == 'Party' %}selected{% endif %}>Party</option>
                                                                <option value="Conference" {% if app.request.query.get('category') == 'Conference' %}selected{% endif %}>Conference</option>
                                                                <option value="Workshop" {% if app.request.query.get('category') == 'Workshop' %}selected{% endif %}>Workshop</option>
                                                                <option value="Formation" {% if app.request.query.get('category') == 'Formation' %}selected{% endif %}>Formation</option>
                                                            </select>
                                                        </div>
                                                        <div class="col-lg-3" style="color: white">
                                                            <select name="local" class="form-control" style="background-color:darkslategray;color: white" >
                                                                <option value="" >Location </option>
                                                                {% for location in locations %}
                                                                    <option value="{{ location.id }}" {% if app.request.query.get('local') == location.id %}selected{% endif %}>{{ location.name }}</option>
                                                                {% endfor %}
                                                            </select>
                                                        </div>
                                                    </div>
                                                    <div class="row mt-3">
                                                        <div class="col-lg-12">
                                                            <button type="submit" class="btn btn-primary" style="background-color: darkslategrey;border-color: darkslategrey">Apply Filters</button>
                                                            <a href="{{ path('app_event') }}" class="btn btn-secondary">Clear Filters</a>
                                                        </div>
                                                    </div>
                                                </form>
                                            </div>
                                                <div class="container" style="margin-left:250px;margin-top: 20px ">
                                                    <div class="col">
                                                        <div class="col-lg-100">
                                                            <div class="main-content">
                                                                <div class="next-show">
                                                                    <i class="fa fa-arrow-down"></i>
                                                                    <span>Discover Events</span>
                                                                </div>

                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                
                                                {% for e in events %}
                                                    <div class="col-lg-12" style="margin-top: 100px">
                                                        <div class="event-item">
                                                            <div class="row">
                                                                <div class="col-lg-4">
                                                                    <div class="left-content">
                                                                        <h4>{{ e.nom }}</h4>
                                                                        <p>{{ e.description }}</p>
                                                                        <div class="main-dark-button"><a href="event-details.html">Discover More</a></div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-lg-4">
                                                                    {% if 'Party' in e.category %}
                                                                        <div><img class="event-image" src="{{ asset('assets/images/venue-01.jpg') }}" alt=""></div>
                                                                    {% endif %}
                                                                    {% if 'conference' in e.category %}
                                                                        <div><img class="event-image" src="{{ asset('assets/images/download (13).jpg') }}" alt=""></div>
                                                                    {% endif %}
                                                                    {% if 'workshop' in e.category %}
                                                                        <div><img class="event-image" src="{{ asset('assets/images/workshop.jpg') }}" alt=""></div>
                                                                    {% endif %}
                                                                    {% if 'formation' in e.category %}
                                                                        <div><img class="event-image" src="{{ asset('assets/images/formation.jpg') }}" alt=""></div>
                                                                    {% endif %}
                                                                </div>
                                                                <div class="col-lg-4">
                                                                    <div class="right-content">
                                                                        <ul>
                                                                            <li>
                                                                                <i class="fa fa-clock-o"></i>
                                                                                <h6>{{ e.date|date('Y-m-d') }}<br>11:20 AM - 10:20 PM</h6>
                                                                            </li>
                                                                            <li>
                                                                                <i class="fa fa-map-marker"></i>
                                                                                <span>{{ e.local.getName()}}</span>
                                                                            </li>
                                                                            <li>
                                                                                <i class="fa fa-users"></i>
                                                                                <span>540 Total Guests Attending</span>
                                                                            </li>
                                                                        </ul>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}

                                            </div>
                                        </div>
                                    </div>
                                </article>

                            </section>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- *** Subscribe *** -->
    <div class="subscribe">
        <div class="container">
            <div class="row">
                <div class="col-lg-4">
                    <h4>Subscribe Our Newsletter:</h4>
                </div>
                <div class="col-lg-8">
                    <form id="subscribe" action="" method="get">
                        <div class="row">
                          <div class="col-lg-9">
                            <fieldset>
                              <input name="email" type="text" id="email" pattern="[^ @]*@[^ @]*" placeholder="Your Email Address" required="">
                            </fieldset>
                          </div>
                          <div class="col-lg-3">
                            <fieldset>
                              <button type="submit" id="form-submit" class="main-dark-button">Submit</button>
                            </fieldset>
                          </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- *** Footer *** -->




    <!-- jQuery -->
    <script src="{{ asset('assets/js/jquery-2.1.0.min.js') }}"></script>

    <!-- Bootstrap -->
    <script src="{{ asset('assets/js/popper.js') }}"></script>
    <script src="{{ asset('assets/js/bootstrap.min.js') }}"></script>

    <!-- Plugins -->
    <script src="{{ asset('assets/js/scrollreveal.min.js') }}"></script>
    <script src="{{ asset('assets/js/waypoints.min.js') }}"></script>
    <script src="{{ asset('assets/js/jquery.counterup.min.js') }}"></script>
    <script src="{{ asset('assets/js/imgfix.min.js') }}"></script>
    <script src="{{ asset('assets/js/mixitup.js') }}"></script>
    <script src="{{ asset('assets/js/accordions.js') }}"></script>
    <script src="{{ asset('assets/js/owl-carousel.js') }}"></script>

    <!-- Global Init -->
    <script src="{{ asset('assets/js/custom.js') }}"></script>

  </body>

{% endblock %}
