{% extends 'base.html.twig' %}

{% block title %}Créer un nouveau local{% endblock %}

{% block body %}
    <h1>Créer un nouveau local</h1>

    {{ form_start(form) }}
    {{ form_row(form.name) }}
    {{ form_row(form.adr) }}
    {{ form_row(form.capacite) }}
    {{ form_row(form.description) }}
    {{ form_row(form.price) }}


    <button class="btn btn-primary">Enregistrer</button>
    {{ form_end(form) }}

    <a href="{{ path('app_local_index') }}" class="btn btn-secondary mt-3">Retour à la liste</a>
{% endblock %}
