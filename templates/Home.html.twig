{% extends 'base.html.twig' %}

{% block title %}Home{% endblock %}

{% block body %}

<head>

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="Tooplate">
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&display=swap" rel="stylesheet">

    <title>ArtXibition HTML Event Template</title>


    <!-- Additional CSS Files -->
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/bootstrap.min.css') }}">

    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/font-awesome.css') }}">

    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/owl-carousel.css') }}">

    <link rel="stylesheet" href="{{ asset('assets/css/tooplate-artxibition.css') }}">
    <!--

    Tooplate 2125 ArtXibition

    https://www.tooplate.com/view/2125-artxibition

    -->
</head>


<body>

<!-- ***** Preloader End ***** -->

<!-- ***** Pre HEader ***** -->


<!-- ***** Preloader Start ***** -->

<div id="js-preloader" class="js-preloader">
    <div class="preloader-inner">
        <span class="dot"></span>
        <div class="dots">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>
</div>
<!-- ***** Preloader End ***** -->

<!-- ***** Pre HEader ***** -->


<!-- ***** Header Area Start ***** -->

<!-- ***** Header Area End ***** -->

<!-- ***** Main Banner Area Start ***** -->
<div class="main-banner">

        <div class="row">
            <div class="col-lg-11">
                <div class="main-content">
                    <div class="next-show">
                        <i class="fa fa-arrow-down"></i>
                        <span>Discover Events</span>
                    </div>

                </div>
            </div>
    </div>
</div>
<!-- ***** Main Banner Area End ***** -->

<!-- *** Owl Carousel Items ***-->
<div class="show-events-carousel">
        <div class="row">
            <div class="col-lg-12">
                <div class="owl-show-events owl-carousel">
                    <div class="item">
                        <a href="{{ path('app_event') }}">
                            <img src="{{ asset('assets/images/download (11).jpg') }}" alt="Event Image">
                        </a>
                    </div>
                    <div class="item">
                        <a href="{{ path('app_event') }}">
                            <img src="{{ asset('assets/images/download (13).jpg') }}" alt="Event Image">
                        </a>
                    </div>
                    <div class="item">
                        <a href="{{ path('app_event') }}">
                            <img src="{{ asset('assets/images/download (14).jpg') }}" alt="Event Image">
                        </a>
                    </div>
                    <div class="item">
                        <a href="{{ path('app_event') }}">
                            <img src="{{ asset('assets/images/show-events-01.jpg') }}" alt="Event Image">
                        </a>
                    </div>

                    <div class="item">
                        <a href="{{ path('app_event') }}">
                            <img src="{{ asset('assets/images/show-events-04.jpg') }}" alt="Event Image">
                        </a>
                    </div>
                </div>

            </div>
    </div>
</div>


<!-- *** Amazing Venus ***-->
<div class="amazing-venues">
        <div class="row">
            <div class="col-lg-9">
                <div class="left-content">
                    <h4>What MY EVENT is ?</h4>
                    <br>
                        <h6>Our platform is the ultimate bridge between participants and event organizers. Whether you're an organizer planning an event or a participant looking to join one, we've got you covered. Organizers can effortlessly manage their events with just a few clicks and easily find the perfect venue for their needs. Join us to simplify event management and create memorable experiences!
                        </h6>
                </div>
            </div>
            <div class="col-lg-3">
                <div class="right-content">
                    <h5><i class="fa fa-map-marker"></i> Visit Us</h5>
                    <span>Rue Casablanca,<br>Bardo,<br> Tunisia</span>
                </div>
            </div>
        </div>
</div>


<!-- *** Map ***-->
{# <div class="map-image">
    <img src="assets/images/map-image.jpg" alt="Maps of 3 Venues">
</div>
#}

<!-- *** Venues & Tickets ***-->
<div class="venue-tickets" >
        <div class="row">

            {%if events|length>1%}
                <div class="col-lg-12">
                    <div class="section-heading">
                        <h2>Next Events</h2>
                    </div>
                </div>
            {% for e in 0..2 %}
                <div class="col-lg-4">
                    <div class="venue-item">
                        <div class="thumb">
                            {% if 'party' in events[e].category %}
                                <div><img class="event-image" src="{{ asset('assets/images/venue-01.jpg') }}" alt=""></div>
                            {% endif %}
                            {% if 'conference' in events[e].category %}
                                <div><img class="event-image" src="{{ asset('assets/images/download (13).jpg') }}" alt=""></div>
                            {% endif %}
                            {% if 'workshop' in events[e].category %}
                                <div><img class="event-image" src="{{ asset('assets/images/workshop.jpg') }}" alt=""></div>
                            {% endif %}
                            {% if 'training' in events[e].category %}
                                <div><img class="event-image" src="{{ asset('assets/images/formation.jpg') }}" alt=""></div>
                            {% endif %}
                        </div>
                        <div class="down-content">
                            <div class="left-content">
                                <div class="main-white-button">
                                    <a href="{{ path('app_event') }}">Discover More </a>
                                </div>
                            </div>
                            <div class="right-content">
                                <h4>{{ events[e].nom }}</h4>
                                <p></p>
                                <ul>
                                    <li><i class="fa fa-sitemap"></i>{{ events[e].local.getCapacite() }}</li>
                                    <li><i class="fa fa-user"></i>{{ events[e].getTotalParticipants() }}</li>
                                </ul>
                                <div class="price">
                                    <span>1 ticket<br> <em>{{ events[e].getPrix() }} DT</em></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
            {% endif %}

        </div>
</div>
<div style="margin-bottom: 50px;margin-top: 50px">
    <div class="col-lg-12">
        <div class="section-heading" style="  background-color: #062c33;color: white;border-radius: 20px
" >
            <h2>Our Services</h2>
        </div>
    </div>
    <div><img  class="service-image" src="{{ asset('assets/images/org2.jpg') }}" alt=""></div>
    <div class="row" style="text-align: center">
        <div class="col-lg-4">
            <div class="section-heading">
                <h2>Organize Events</h2>
            </div>
        <img style="width: 200px;height: 200px" src="{{ asset('assets/images/org3.jpg') }}" alt="">
            <h6>
                Plan your perfect event effortlessly with our tools. Create, manage, and share your vision with ease.
            </h6>
        </div>
        <div class="col-lg-4">
            <div class="section-heading">
                <h2>Rent Venues</h2>
            </div>
        <img style="width: 200px;height: 200px" src="{{ asset('assets/images/venue.jpg') }}" alt="">
        <h6>Offer your venue for rent or find the ideal space for your event. Simplify the process for locators and organizers alike.</h6>
        </div>
        <div class="col-lg-4">
            <div class="section-heading">
                <h2>Make Reservations</h2>
            </div>
        <img style="width: 200px;height: 200px" src="{{ asset('assets/images/participate.jpg') }}" alt="">
            <h6>Discover exciting events tailored to your interests. Join, engage, and make unforgettable memories.</h6>
        </div>


    </div>
</div>




<!-- *** Subscribe *** -->
<div class="subscribe">
        <div class="row">
            <div class="col-lg-4">
                <h4>Subscribe Our Newsletter:</h4>
            </div>
            <div class="col-lg-8">
                <form id="subscribe" action="" method="get">
                    <div class="row">
                        <div class="col-lg-9">
                            <fieldset>
                                <input name="email" type="text" id="email" pattern="[^ @]*@[^ @]*" placeholder="Your Email Address" required="">
                            </fieldset>
                        </div>
                        <div class="col-lg-3">
                            <fieldset>
                                <button type="submit" id="form-submit" class="main-dark-button">Submit</button>
                            </fieldset>
                        </div>
                    </div>
                </form>
            </div>
        </div>
</div>

<!-- *** Footer *** -->


<!-- jQuery -->


</body>
{% endblock %}
