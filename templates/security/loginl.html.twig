{% extends 'base.html.twig' %}

{% block title %}Log in{% endblock %}

{% block body %}
    <div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center bg-white">
        <div class="row w-100 shadow-lg" style="max-width: 900px; border-radius: 10px; overflow: hidden; border: 1px solid #17B8A6;">
            <!-- Partie gauche : Image -->
            <div class="col-lg-6 d-flex justify-content-center align-items-center p-4" style="background-color: #17B8A6;">
                <img src="{{ asset('assets/img/login-image.svg') }}" alt="Log in" class="img-fluid" style="max-height: 300px;">
            </div>

            <!-- Partie droite : Formulaire -->
            <div class="col-lg-6 p-4">
                <div class="text-center mb-4">
                    <h3 class="fw-bold" style="color: #17B8A6;">Sign in</h3>
                </div>
                <div class="card border-0">
                    <div class="card-body">
                        <form class="form-signin" action="{{ path('app_login') }}" method="post">
                            {% if error %}
                                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            {% endif %}

                            {% if app.user %}
                                <div class="mb-3 text-center">
                                    You are logged in as {{ app.user.userIdentifier }},
                                    <a href="{{ path('app_logout') }}" class="text-decoration-none" style="color: #17B8A6;">Logout</a>
                                </div>
                            {% endif %}

                            <div class="form-floating mb-3">
                                <input type="email" value="{{ last_username }}" name="email" id="floatingInput" class="form-control" placeholder="name@example.com" autocomplete="email" required style="border: 1px solid #17B8A6;">
                                <label for="floatingInput">Email address</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input type="password" name="password" id="floatingPassword" class="form-control" placeholder="Password" autocomplete="current-password" required style="border: 1px solid #17B8A6;">
                                <label for="floatingPassword">Password</label>
                            </div>

                            <div class="form-check text-start my-3">
                                <input class="form-check-input" type="checkbox" value="remember-me" id="flexCheckDefault">
                                <label class="form-check-label" for="flexCheckDefault">
                                    Remember me
                                </label>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="d-grid mb-3">
                                <button class="btn btn-lg" type="submit" style="background-color: #17B8A6; color: #fff; border: none;">Sign in</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Lien supplémentaire -->
                <p class="text-center mt-3">
                    Don't have an account?
                    <a href="{{ path('app_register') }}" class="text-decoration-none" style="color: #17B8A6;">Sign up</a>
                </p>

                <p class="text-center mt-3">
                    Forgot your password?
                    <a href="{{ path('app_forgot_password') }}" class="text-decoration-none" style="color: #17B8A6;">Reset it here</a>
                </p>

                <p class="mt-4 mb-0 text-body-secondary text-center">&copy; 2017–2024</p>
            </div>
        </div>
    </div>
{% endblock %}
