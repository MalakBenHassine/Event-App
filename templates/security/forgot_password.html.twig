{% extends 'base.html.twig' %}

{% block title %}Demande de Réinitialisation{% endblock %}

{% block body %}
    <div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center bg-white">
        <div class="row w-100 shadow-lg" style="max-width: 900px; border-radius: 10px; overflow: hidden; border: 1px solid #17B8A6;">
            <!-- Partie gauche : Image agrandie -->
            <div class="col-lg-6 d-flex justify-content-center align-items-center p-4" style="background-color: #17B8A6;">
                <img src="{{ asset('assets/img/reset-request.svg') }}" alt="Réinitialisation" class="img-fluid" style="max-height: 300px;">
            </div>

            <!-- Partie droite : Formulaire -->
            <div class="col-lg-6 p-4">
                <div class="text-center mb-4">
                    <h3 class="fw-bold" style="color: #17B8A6;">Réinitialisez votre mot de passe</h3>
                </div>
                <div class="card border-0">
                    <div class="card-body">
                        <form method="post" action="{{ path('app_request_password_reset') }}">
                            <div class="mb-3">
                                <label for="email" class="form-label fw-bold">E-mail</label>
                                <input type="email" id="email" name="email" class="form-control" placeholder="Entrez votre adresse e-mail" required style="border: 1px solid #17B8A6;">
                            </div>
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-lg" style="background-color: #17B8A6; color: #fff; border: none;">Envoyer</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Lien retour connexion -->
                <div class="text-center mt-3">
                    <a href="{{ path('app_login') }}" class="text-decoration-none fw-bold" style="color: #17B8A6;">Retour à la connexion</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
