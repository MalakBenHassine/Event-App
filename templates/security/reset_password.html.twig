{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe{% endblock %}

{% block body %}
    <div class="container-fluid min-vh-100 d-flex justify-content-center align-items-center bg-white">
        <div class="row w-100 shadow-lg" style="max-width: 900px; border-radius: 10px; overflow: hidden; border: 1px solid #17B8A6;">
            <!-- Partie gauche : Image -->
            <div class="col-lg-6 d-flex justify-content-center align-items-center p-4 bg-white">
                <img src="{{ asset('assets/img/pass.svg') }}" alt="Réinitialisation du mot de passe" class="img-fluid" style="max-height: 300px;">
            </div>

            <!-- Partie droite : Formulaire -->
            <div class="col-lg-6 p-4 bg-light">
                <div class="text-center mb-4">
                    <h3 class="fw-bold" style="color: #17B8A6;">Réinitialiser votre mot de passe</h3>
                </div>
                <div class="card border-0">
                    <div class="card-body">
                        <form action="{{ path('app_reset_password', {'token': token}) }}" method="post">
                            <!-- Nouveau mot de passe -->
                            <div class="form-floating mb-3">
                                <input type="password" id="new_password" name="new_password" class="form-control" placeholder="Nouveau mot de passe" required style="border: 1px solid #17B8A6;">
                                <label for="new_password">Nouveau mot de passe</label>
                            </div>

                            <!-- Bouton de réinitialisation -->
                            <div class="d-grid mb-3">
                                <button type="submit" class="btn btn-lg" style="background-color: #17B8A6; color: #fff; border: none;">Réinitialiser</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Lien retour -->
                <p class="text-center mt-3">
                    <a href="{{ path('app_login') }}" class="text-decoration-none" style="color: #17B8A6;">Retour à la connexion</a>
                </p>
            </div>
        </div>
    </div>
{% endblock %}
