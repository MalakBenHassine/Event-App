{% extends 'base.html.twig' %}

{% block title %}Liste des participants pour {{ event.nom }}{% endblock %}

{% block body %}
    <div class="container my-5">
        <h1 class="text-center mb-4" style="color: #17B8A6;">Liste des participants pour {{ event.nom }}</h1>

        {# Affichage des messages de flash pour la réussite ou l'erreur #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success text-center" style="background-color: #17B8A6; color: white;">
                {{ message }}
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger text-center">
                {{ message }}
            </div>
        {% endfor %}

        <div class="card shadow-lg border-0">
            <div class="card-body">

                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="thead-light" style="background-color: #17B8A6; color: white;">
                        <tr>
                            <th scope="col">Nom</th>
                            <th scope="col">Email</th>
                            <th scope="col">Téléphone</th>
                            <th scope="col">Date de réservation</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for reservation in reservations %}
                            <tr>
                                <td>{{ reservation.user.name }}</td>
                                <td>{{ reservation.user.email }}</td>
                                <td>{{ reservation.user.phone }}</td>
                                <td>{{ reservation.date | date('Y-m-d') }}</td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted">Aucun participant inscrit pour cet événement.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

