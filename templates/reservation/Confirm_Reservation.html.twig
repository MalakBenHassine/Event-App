<form  method="post" action="{{ path('reservation_confirm', {'id': reservation.id}) }}" onsubmit="return confirm('Are you sure you want to pay for the reservation?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reservation.id) }}">
    <button style="background-color: #062c33;color: white" class="btn">Payment</button>
</form>
